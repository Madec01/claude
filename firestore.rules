// Règles de sécurité Firestore de Cent Saisons. À copier dans la console Firebase :
// Firestore Database → onglet Règles → tout remplacer → Publier.
// Ce sont ELLES qui protègent les sauvegardes, pas le secret des clés (qui sont publiques par conception).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // un joueur connecté lit et écrit sa fiche, la sienne seulement, et pas plus de 200 Ko
    match /parties/{joueur} {
      allow read, write: if request.auth != null
        && request.auth.uid == joueur
        && request.resource.size() < 200000;
    }
    // tout le reste est refusé
    match /{document=**} { allow read, write: if false; }
  }
}
