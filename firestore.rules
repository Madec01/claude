// Règles de sécurité Firestore de Cent Saisons. À copier dans la console Firebase :
// Firestore Database → onglet Règles → tout remplacer → Publier.
// Ce sont ELLES qui protègent les sauvegardes, pas le secret des clés (qui sont publiques par conception).
//
// Attention au piège : `request.resource` n'existe QUE pour une création ou une modification. Sur une lecture ou un
// effacement il vaut null, et une condition qui s'appuie dessus échoue — donc refuse tout. Les trois cas sont donc
// écrits séparément. Vérifié par `tests/firestore_rules.mjs`, qui joue ces règles dans l'émulateur Firestore.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // la fiche d'un joueur : la sienne, et rien d'autre
    match /parties/{joueur} {
      allow read:   if request.auth != null && request.auth.uid == joueur;
      allow delete: if request.auth != null && request.auth.uid == joueur;
      allow create, update: if request.auth != null && request.auth.uid == joueur
        && request.resource.data.save is string
        && request.resource.data.save.size() < 200000;
    }
    // les pépins et les idées : on en dépose, on n'en lit aucun. Le relevé passe par le SDK d'administration,
    // qui n'est pas soumis à ces règles. Les trois cas restent séparés (cf. le piège de `request.resource`).
    match /pepins/{pepin} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['code', 'at', 'rapport', 'image'])
        && request.resource.data.rapport is string
        && request.resource.data.rapport.size() < 120000
        && (!('image' in request.resource.data) || request.resource.data.image.size() < 300000);
      allow read, update, delete: if false;
    }
    // l'état des rapports : lisible par tous, écrit par personne. C'est la relève qui le réécrit, par le SDK
    // d'administration, qui n'est pas soumis à ces règles. Public sans risque PARCE QU'il ne contient que des
    // codes et des états : un code de quatre caractères ne dit rien à qui ne l'a pas envoyé. Y mettre un titre
    // ou la phrase d'un joueur rendrait public ce que le carnet privé protège — c'est la seule chose à ne pas
    // faire ici. (Les trois cas restent séparés : cf. le piège de `request.resource` en tête de fichier.)
    match /etats/{doc} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    // tout le reste est refusé
    match /{document=**} { allow read, write: if false; }
  }
}
